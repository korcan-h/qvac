+// TEMP DIAGNOSTIC (debug/cuda-capture-ci, do not merge): which op allocates during CUDA graph
+// capture (graph memory nodes, from cudaMallocAsync) and which op first sees a CUDA error.
+static thread_local const char * ggml_cuda_diag_mm_path = "";
+
+static void ggml_cuda_diag_describe(const char * what, const ggml_tensor * t) {
+    GGML_LOG_ERROR("[diag] %s: %s (%s) type=%s ne=[%lld,%lld,%lld,%lld]%s%s\n", what, t->name, ggml_op_desc(t),
+                   ggml_type_name(t->type), (long long) t->ne[0], (long long) t->ne[1], (long long) t->ne[2],
+                   (long long) t->ne[3], t->op == GGML_OP_MUL_MAT ? " mm_path=" : "",
+                   t->op == GGML_OP_MUL_MAT ? ggml_cuda_diag_mm_path : "");
+    for (int j = 0; j < 3; j++) {
+        const ggml_tensor * s = t->src[j];
+        if (s != nullptr) {
+            GGML_LOG_ERROR("[diag]     src%d: %s type=%s ne=[%lld,%lld,%lld,%lld]\n", j, s->name, ggml_type_name(s->type),
+                           (long long) s->ne[0], (long long) s->ne[1], (long long) s->ne[2], (long long) s->ne[3]);
+        }
+    }
+}
+
+// Scans the graph being captured for memory nodes added since the last call and attributes them to op.
+struct ggml_cuda_diag_capture_scan {
+    bool                         enabled = false;
+    size_t                       seen    = 0;
+    int                          logged  = 0;
+    int                          alloc_nodes = 0;
+    std::vector<cudaGraphNode_t> nodes;
+
+    void scan(cudaStream_t stream, const ggml_tensor * op) {
+        if (!enabled || op == nullptr) {
+            return;
+        }
+        cudaStreamCaptureStatus status = cudaStreamCaptureStatusNone;
+        cudaGraph_t             graph  = nullptr;
+        size_t                  n      = 0;
+        if (cudaStreamGetCaptureInfo(stream, &status, nullptr, &graph) != cudaSuccess || graph == nullptr ||
+            cudaGraphGetNodes(graph, nullptr, &n) != cudaSuccess) {
+            (void) cudaGetLastError();
+            GGML_LOG_ERROR("[diag] capture scan unavailable, disabled\n");
+            enabled = false;
+            return;
+        }
+        if (n <= seen) {
+            return;
+        }
+        nodes.resize(n);
+        if (cudaGraphGetNodes(graph, nodes.data(), &n) != cudaSuccess) {
+            (void) cudaGetLastError();
+            enabled = false;
+            return;
+        }
+        int allocs = 0;
+        int frees  = 0;
+        for (size_t k = seen; k < n; k++) {
+            cudaGraphNodeType type;
+            if (cudaGraphNodeGetType(nodes[k], &type) != cudaSuccess) {
+                (void) cudaGetLastError();
+                continue;
+            }
+            allocs += type == cudaGraphNodeTypeMemAlloc;
+            frees  += type == cudaGraphNodeTypeMemFree;
+        }
+        seen = n;
+        alloc_nodes += allocs;
+        if ((allocs > 0 || frees > 0) && logged < 40) {
+            logged++;
+            char what[64];
+            snprintf(what, sizeof(what), "op added %d mem-alloc / %d mem-free nodes", allocs, frees);
+            ggml_cuda_diag_describe(what, op);
+        }
+    }
+};
+
+static void ggml_cuda_diag_graph_summary(cudaGraph_t graph) {
+    size_t n = 0;
+    if (cudaGraphGetNodes(graph, nullptr, &n) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return;
+    }
+    std::vector<cudaGraphNode_t> nodes(n);
+    if (cudaGraphGetNodes(graph, nodes.data(), &n) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return;
+    }
+    int kernels = 0, allocs = 0, frees = 0, other = 0;
+    for (cudaGraphNode_t node : nodes) {
+        cudaGraphNodeType type;
+        if (cudaGraphNodeGetType(node, &type) != cudaSuccess) {
+            (void) cudaGetLastError();
+            continue;
+        }
+        if (type == cudaGraphNodeTypeKernel) {
+            kernels++;
+        } else if (type == cudaGraphNodeTypeMemAlloc) {
+            allocs++;
+        } else if (type == cudaGraphNodeTypeMemFree) {
+            frees++;
+        } else {
+            other++;
+        }
+    }
+    GGML_LOG_ERROR("[diag] captured graph: %zu nodes (%d kernels, %d mem-alloc, %d mem-free, %d other)\n", n, kernels,
+                   allocs, frees, other);
+}
